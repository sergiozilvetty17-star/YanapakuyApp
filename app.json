{
    "expo":  {
                 "name":  "YanapakuyApp",
                 "slug":  "YanapakuyApp",
                 "version":  "1.0.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/images/yanapakuy-icon.png",
                 "scheme":  "yanapakuyapp",
                 "userInterfaceStyle":  "automatic",
                 "ios":  {
                             "icon":  "./assets/expo.icon"
                         },
                 "android":  {
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#D62839",
                                                      "foregroundImage":  "./assets/images/yanapakuy-icon-foreground.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false,
                                 "package":  "com.szvtty.YanapakuyApp"
                             },
                 "web":  {
                             "output":  "bundled",
                             "favicon":  "./assets/images/favicon.png"
                         },
                 "plugins":  [
                                 "expo-router",
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#208AEF",
                                         "image":  "./assets/images/yanapakuy-icon.png",
                                         "imageWidth":  76
                                     }
                                 ]
                             ],
                 "experiments":  {
                                     "typedRoutes":  true,
                                     "reactCompiler":  true
                                 },
                 "extra":  {
                               "router":  {

                                          },
                               "eas":  {
                                           "projectId":  "d1fe56d7-39c6-4f36-81a8-dde5bc24f4bb"
                                       }
                           }
             }
}